# YouTube Automation Agent Environment Configuration
# Copy this file to .env and fill in your actual values

# AI Provider - Pick one (or use OpenRouter for access to all)
# Uncomment the line you use — placeholder values must stay commented out
# OPENAI_API_KEY=your-openai-api-key-here
# OPENROUTER_API_KEY=your-openrouter-api-key-here
# GEMINI_API_KEY=your-gemini-api-key-here
# MOONSHOT_API_KEY=your-kimi-api-key-here
# MIMO_API_KEY=your-mimo-api-key-here
# GLM_API_KEY=your-glm-api-key-here

# ElevenLabs TTS (optional, higher quality than OpenAI TTS)
# ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
# ELEVENLABS_VOICE_ID=your-voice-id-here

# Replicate (optional, for AI video generation)
# REPLICATE_API_KEY=your-replicate-api-key-here

# Gemini media generation (used when GEMINI_API_KEY is your provider)
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# GEMINI_TTS_VOICE=Kore

# FFmpeg (optional override; resolution order: FFMPEG_PATH > bundled ffmpeg-static > system PATH)
# FFMPEG_PATH=

# Azure Speech TTS (optional alternative)
# AZURE_SPEECH_KEY=your-azure-speech-key-here
# AZURE_SPEECH_REGION=eastus

# Application Settings
NODE_ENV=production
PORT=3456
LOG_LEVEL=info

# Channel Settings
CHANNEL_NAME=Your Channel Name
DEFAULT_AUTHOR=Your Name
TARGET_AUDIENCE=Your target audience description

# Multi-Topic × Multi-Language Content Matrix
# Each daily run publishes every topic in the next language of this rotation,
# so the channel reaches multiple geolocations (en hi es pt ar id, ...).
# Leave unset for the built-in roster (all six languages).
# CONTENT_LANGUAGES=hi,en,es,pt,ar,id
# Custom topics override the built-ins (pipe-separated; commas allowed inside a topic):
# CONTENT_TOPICS=2D Cartoon Storytime: School Comedy|Candlestick Trading Tutorial
# Viral factory plan: 1 long-form + 3 Shorts per day (US prime-time slots)
# DAILY_SHORTS=3
# PUBLISH_TIMEZONE=America/New_York
# LONG_PUBLISH_HOUR=19
# SHORT_PUBLISH_HOURS=9,13,17

# YouTube Settings
YOUTUBE_REGION=US
DEFAULT_PRIVACY_STATUS=private

# Content Settings
AUTO_SHORTEN_CONTENT=true
AUTO_ADD_BACKLINKS=true
PRESERVE_FORMATTING=true
AUTO_RESIZE_IMAGES=true
MAX_IMAGE_WIDTH=1280
MAX_IMAGE_HEIGHT=720
IMAGE_QUALITY=90

# Rate Limiting
GLOBAL_RATE_LIMIT_PER_HOUR=50
DEFAULT_DELAY_BETWEEN_POSTS=60000

# Security
# Optional. If set, mutating API routes require this value in the x-api-key header.
API_KEY=

# Analytics & Monitoring
ENABLE_ANALYTICS=true
ANALYTICS_DB_PATH=./data/analytics.db

# File Upload Settings
MAX_FILE_SIZE=52428800
UPLOAD_PATH=./uploads

# Error Handling
RETRY_ATTEMPTS=3
RETRY_DELAY=5000
